+fn color_ref_hex(value: u32) -> String {
+    if value == 0xFFFF_FFFF {
+        "none".to_string()
+    } else {
+        format!(
+            "#{:02X}{:02X}{:02X}",
+            value & 0xFF,
+            (value >> 8) & 0xFF,
+            (value >> 16) & 0xFF
+        )
+    }
+}
