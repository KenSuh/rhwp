+                .map(|(side, name)| {
+                    format!(
+                        r##"<hh:{name} type="SOLID" width="{} mm" color="#123456"/>"##,
+                        C23_BORDER_WIDTHS[(index + side) % 16],
+                    )
+                })
+                .collect::<String>();
