+                    (ps.attr1 >> 22) & 1,
+                    ps.attr2 & 3,
+                    (ps.attr2 >> 4) & 3,
+                    (ps.attr1 >> 20) & 3,
+                    (ps.attr1 >> 5) & 3,
+                    (ps.attr1 >> 7) & 1
