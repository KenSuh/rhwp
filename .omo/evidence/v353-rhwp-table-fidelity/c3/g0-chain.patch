+fn c9_body_geometry(
+    doc: &rhwp::model::document::Document,
+) -> Vec<Vec<(u32, i32, i32, i32, i32, i32, i32, i32, u32)>> {
+    doc.sections[0]
+        .paragraphs
+        .iter()
+        .map(|p| {
+            p.line_segs
+                .iter()
+                .map(|s| {
+                    (
+                        s.text_start,
+                        s.vertical_pos,
+                        s.line_height,
+                        s.text_height,
+                        s.baseline_distance,
+                        s.line_spacing,
+                        s.column_start,
+                        s.segment_width,
+                        s.tag,
+                    )
+                })
+                .collect()
+        })
+        .collect()
+}
