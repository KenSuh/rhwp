+            let allowed = if begin {
+                matches!(
+                    key.as_str(),
+                    "id" | "type" | "name" | "editable" | "dirty" | "zorder" | "fieldid"
+                )
+            } else {
+                matches!(key.as_str(), "beginIDRef" | "fieldid")
+            };
+            if !allowed {
+                return Err(SerializeError::XmlError(format!(
